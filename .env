# Handyeco Telegram Notification Configuration
# Telegram'da @BotFather üzerinden oluşturduğunuz bot token'ını buraya yazın:
TELEGRAM_BOT_TOKEN=

# Telegram'da @userinfobot üzerinden alabileceğiniz kendi kullanıcı ID'nizi buraya yazın:
TELEGRAM_CHAT_ID=

# API Server Port
PORT=3001

# SECURITY: Admin panel password - CHANGE THIS to a strong password before going live!
# Minimum 16 karakter, büyük/küçük harf, rakam ve özel karakter kullanın.
ADMIN_PASSWORD=HandyEco@2026!Secure#Panel

# SECURITY: TOTP / Google Authenticator 2FA
# Bu değeri boş bırakın - otomatik olarak oluşturulacak ve admin_config.json'a kaydedilecek
TOTP_ISSUER=Handyeco Admin Panel

# SECURITY: CORS - Production'da kendi domain adresinizi yazın (örn: https://handyeco.co.uk)
# Birden fazla origin için virgülle ayırın
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3001

